{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PrgBattle Spec Validation",
    "type": "object",
    "$defs": {
        "game_setting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "terrain_type_dict",
                "forest_type_dict",
                "move_type_dict",
                "unit_type_dict"
            ],
            "properties": {
                "terrain_type_dict": {
                    "$ref": "schema_map.json#/$defs/terrain_type_dict"
                },
                "forest_type_dict": {
                    "$ref": "schema_map.json#/$defs/forest_type_dict"
                },
                "resource_type_dict": {
                    "$ref": "schema_map.json#/$defs/resource_type_dict"
                },
                "move_type_dict": {
                    "$ref": "schema_map.json#/$defs/move_type_dict"
                },
                "unit_type_dict": {
                    "$ref": "schema_unit.json#/$defs/unit_type_dict"
                },
                "facility_type_dict": {
                    "$ref": "schema_facility.json#/$defs/facility_type_dict"
                }
            }
        },
        "game_result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "map_static",
                "map_history",
                "base_infos",
                "facility_infos",
                "unit_infos",
                "country_infos",
                "wars"
            ],
            "properties": {
                "map_static": {
                    "$ref": "schema_map.json#/$defs/map_static"
                },
                "map_history": {
                    "$ref": "schema_map.json#/$defs/map_history"
                },
                "base_infos": {
                    "type": "object",
                    "description": "拠点IDをキーとする辞書",
                    "patternProperties": {
                        "^[A-Za-z0-9_\\-\\.]+$": {
                            "$ref": "schema_base.json#/$defs/base_info"
                        }
                    }
                },
                "facility_infos": {
                    "type": "object",
                    "description": "施設IDをキーとする辞書",
                    "patternProperties": {
                        "^[A-Za-z0-9_\\-\\.]+$": {
                            "$ref": "schema_facility.json#/$defs/facility_info"
                        }
                    }
                },
                "unit_infos": {
                    "type": "object",
                    "description": "ユニットIDをキーとする辞書",
                    "patternProperties": {
                        "^[A-Za-z0-9_\\-\\.]+$": {
                            "$ref": "schema_unit.json#/$defs/unit_info"
                        }
                    }
                },
                "country_infos": {
                    "type": "object",
                    "description": "国IDをキーとする辞書",
                    "patternProperties": {
                        "^[A-Za-z0-9_\\-\\.]+$": {
                            "$ref": "schema_country.json#/$defs/country_info"
                        }
                    }
                },
                "wars": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/war"
                    }
                }
            }
        },
        "war": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "conutries",
                "start_turn"
            ],
            "properties": {
                "countries": {
                    "type": "array",
                    "description": "交戦国の国IDリスト",
                    "items": {
                        "type": "string"
                    }
                },
                "start_turn": {
                    "type": "integer",
                    "description": "戦争が開始したターン",
                    "minimum": 0
                },
                "end_turn": {
                    "type": "integer",
                    "description": "戦争が終了したターン",
                    "minimum": 0
                }
            }
        }
    }
}