{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PrgBattle Spec Validation",
    "type": "object",
    "$defs": {
        "base_info": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "static",
                "pop_turn",
                "lost_turn",
                "snapshots"
            ],
            "properties": {
                "static": {
                    "$ref": "#/$defs/base_static"
                },
                "pop_turn": {
                    "type": "integer",
                    "description": "拠点が出現したターン"
                },
                "lost_turn": {
                    "type": "integer",
                    "description": "拠点が消えたターン"
                },
                "snapshots": {
                    "type": "array",
                    "description": "存在ターン数(lost_turn-pop_turn)個の要素を持つ配列。出現したターン内に消えた場合は要素数0",
                    "items": {
                        "$ref": "#/$defs/base_snapshot"
                    }
                }
            }
        },
        "base_static": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "position"
            ],
            "properties": {
                "position": {
                    "type": "integer",
                    "description": "位置：x+y*widthの値",
                    "minimum": 0
                }
            }
        },
        "base_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "population",
                "food",
                "material",
                "supply",
                "hunger_point",
                "occupation",
                "loyalty",
                "country_id",
                "connected",
                "wall_scale",
                "wall_strength",
                "monitoring",
                "basic_growth_rate"
            ],
            "properties": {
                "population": {
                    "type": "number",
                    "format": "decimal",
                    "description": "ターン終了時の拠点人口",
                    "minimum": 0.01
                },
                "food": {
                    "type": "number",
                    "description": "ターン終了時の備蓄食糧",
                    "minimum": 0.0
                },
                "material": {
                    "type": "number",
                    "description": "ターン終了時の備蓄材料",
                    "minimum": 0.0
                },
                "supply": {
                    "type": "number",
                    "description": "ターン終了時の備蓄物資",
                    "minimum": 0.0
                },
                "hunger_point": {
                    "type": "number",
                    "description": "ターン終了時の飢餓ポイント",
                    "minimum": 0.0,
                    "maximum": 20.0
                },
                "occupation": {
                    "type": "number",
                    "description": "ターン終了時の占領ポイント。>0は占領状態を意味する。",
                    "minimum": 0.0
                },
                "loyalty": {
                    "type": "object",
                    "description": "ターン終了時の各国への忠誠度の辞書。国IDをキーとする",
                    "patternProperties": {
                        "^[A-Za-z0-9_\\-\\.]+$": {
                            "type": "number",
                            "description": "ターン終了時の忠誠心",
                            "minimum": -100,
                            "maximum": 100
                        }
                    }
                },
                "country_id": {
                    "type": "string",
                    "description": "ターン終了時における所有国の国ID"
                },
                "connected": {
                    "type": "array",
                    "items": {
                        "type":"string",
                        "description": "ターン終了時において直接接続している拠点ID",
                        "pattern": "^[A-Za-z0-9_\\-\\.]+$"
                    }
                },
                "wall_scale": {
                    "type": "number",
                    "description": "ターン終了時の城壁規模",
                    "minimum": 0.0
                },
                "wall_strength": {
                    "type": "number",
                    "description": "ターン終了時の城壁強度",
                    "minimum": 0.0
                },
                "monitoring": {
                    "type": "object",
                    "description": "各国ごとの情報取得最終ターンの辞書。国IDをキーとする",
                    "patternProperties": {
                        "^[A-Za-z0-9_\\-\\.]+$": {
                            "type": "number",
                            "description": "情報取得最終ターン",
                            "minimum": 0
                        }
                    }
                },
                "basic_growth_rate": {
                    "type": "number",
                    "description": "ターン終了時の基準人口増加率",
                    "minimum": 0.0
                }
            }
        }
    }
}